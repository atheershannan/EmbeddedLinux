diff -Naur a/drivers/char/Kconfig b/drivers/char/Kconfig
--- a/drivers/char/Kconfig	2025-12-09 17:09:13.000000000 +0200
+++ b/drivers/char/Kconfig	2026-11-16 23:45:43.991137100 +0200
@@ -432,4 +432,9 @@
