                 register page to the user's pointer.
 
+config MYMOD
+	tristate "My Module"
+	default n
+	help
+	  Hello world kernel module - Logtel exercise.
 endmenu
diff -Naur a/drivers/char/Makefile b/drivers/char/Makefile
--- a/drivers/char/Makefile	2025-12-09 17:09:13.000000000 +0200
+++ b/drivers/char/Makefile	2026-11-16 23:45:43.975136857 +0200
@@ -45,3 +45,4 @@
 obj-$(CONFIG_ADI)		+= adi.o
 obj-$(CONFIG_BRCM_CHAR_DRIVERS) += broadcom/
 obj-$(CONFIG_RASPBERRYPI_GPIOMEM) += raspberrypi-gpiomem.o
+obj-$(CONFIG_MYMOD) += mymod.o
diff -Naur a/drivers/char/mymod.c b/drivers/char/mymod.c
--- a/drivers/char/mymod.c	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/char/mymod.c	2026-11-16 23:45:43.991137100 +0200
@@ -0,0 +1,18 @@
+#include <linux/module.h>
+#include <linux/init.h>
+
+static int __init mymod_init(void)
+{
+	printk(KERN_ALERT "hello world\n");
+	return 0;
+}
+
+static void __exit mymod_exit(void)
+{
+	printk(KERN_ALERT "bye bye world\n");
+}
+
+module_init(mymod_init);
+module_exit(mymod_exit);
+
+MODULE_LICENSE("GPL");
